# PROVIBE Shop: Umgebungsvariablen
# Kopiere diese Datei nach .env.local (lokal) beziehungsweise trage die Werte in Netlify ein.
# Regeln: Nur Variablen mit Präfix NEXT_PUBLIC_ gelangen in den Client. Alles andere ist serverseitig.
# Live-Keys nur im Netlify-Kontext "production". Deploy Previews laufen mit APP_INTEGRATIONS=mock.

# --- Allgemein ---------------------------------------------------------------
# local | preview | production
APP_STAGE=local
# mock | live  (mock = alle externen Dienste als Mock-Implementierung)
APP_INTEGRATIONS=mock
# Öffentliche Basis-URL ohne Slash am Ende (Netlify-Domain bis zum Go-live)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optionaler Basic-Auth-Schutz der gesamten Site bis zum Go-live (leer = aus)
SITE_PROTECT_USER=
SITE_PROTECT_PASSWORD=

# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ajscwnbgaijknmdrtihn.supabase.co
# Publishable Key (sb_publishable_...) oder Legacy anon key. Darf in den Client.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-Role-Key: nur in Netlify Functions / Server Actions, niemals im Client.
SUPABASE_SERVICE_ROLE_KEY=
# Für CLI-Aufgaben (db push, Typen, Backups). Nicht für die App nötig.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=ajscwnbgaijknmdrtihn
SUPABASE_DB_URL=

# --- Stripe (bis zur Freigabe ausschließlich Testmodus, Keys mit rk_test_/pk_test_) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend -------------------------------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_TRANSACTIONAL="provibe <bestellung@provibe-drinks.de>"
EMAIL_FROM_NEWSLETTER="provibe <newsletter@provibe-drinks.de>"
EMAIL_REPLY_TO=hello@provibe-drinks.de
# Bis zum Go-live: Versand nur an diese Empfänger (kommagetrennt, Domain-Einträge mit @ am Anfang)
EMAIL_ALLOWLIST=@provibe-drinks.de,mail@paulschoettler.de

# --- Lexware Office -----------------------------------------------------------
LEXWARE_API_KEY=
# draft = Rechnungen nur als Entwurf (bis zur Freigabe), final = finalisiert
LEXWARE_INVOICE_MODE=draft

# --- DHL Parcel DE Shipping API -----------------------------------------------
DHL_API_KEY=
DHL_USERNAME=
DHL_PASSWORD=
DHL_BILLING_NUMBER=
# sandbox | production
DHL_ENVIRONMENT=sandbox

# --- Tracking (Tokens serverseitig, IDs werden im Backoffice gepflegt) --------
META_CAPI_ACCESS_TOKEN=
GA4_API_SECRET=
TIKTOK_EVENTS_ACCESS_TOKEN=

# --- Sicherheit ---------------------------------------------------------------
# Zufälliger Schlüssel (32+ Zeichen) für signierte Tokens (Newsletter-Bestätigung, Bewertungslinks)
APP_TOKEN_SECRET=
# Secret für den Cron/Job-Endpunkt (Netlify Scheduled Functions rufen ihn auf)
JOBS_RUNNER_SECRET=
